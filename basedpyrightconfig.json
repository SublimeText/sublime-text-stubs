{
  "include": ["stubs", "tests"],
  "extraPaths": ["stubs"],
  "exclude": ["references", "**/__pycache__", ".venv"],
  "pythonVersion": "3.8",
  "typeCheckingMode": "strict",
  "reportMissingModuleSource": false,
  "reportImplicitOverride": "error",
  "reportImplicitStringConcatenation": "error",
  "reportUnnecessaryTypeIgnoreComment": "error",
  "reportPrivateLocalImportUsage": "error",
  "reportImplicitRelativeImport": "error",
  "//": "typeCheckingMode 'all' is unusable on this branch: it enables reportDeprecated, which flags typing.List/Optional as deprecated even though the 3.8 target requires them.",
  "reportDeprecated": false
}
